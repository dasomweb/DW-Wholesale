# DW Wholesale — English for the license screens.
# The DASOM-Forge license SDK ships with Korean source strings and is distributed unchanged to
# several plugins, so its wording is translated here instead of edited. Every other string of the
# plugin is English at the source and needs no entry.
# Maintained catalogue: run `php build/i18n.php all` after editing.
msgid ""
msgstr ""
"Project-Id-Version: DW Wholesale 3.0.0\n"
"Language: en_US\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: dw-wholesale\n"

msgid "SDK 가 손상되었습니다 (필수 메서드 누락). 정상 버전으로 재설치해주세요."
msgstr "The license SDK is damaged (required methods missing). Please reinstall a genuine version."

msgid "integrity.json 이 없습니다. 정상 릴리스 ZIP 으로 재설치해주세요."
msgstr "integrity.json is missing. Please reinstall from the official release ZIP."

msgid "개까지"
msgstr " max"

msgid "권한이 없습니다."
msgstr "You do not have permission."

msgid "누락"
msgstr "missing"

msgid "도메인"
msgstr "Domains"

msgid "등급"
msgstr "Plan"

msgid "라이선스"
msgstr "License"

msgid "라이선스 갱신"
msgstr "Renew license"

msgid "라이선스 상태 새로고침"
msgstr "Refresh license status"

msgid "라이선스 서버 연결이 %d시간째 끊겨 있습니다. 유예가 끝나면 카탈로그 출력이 중단됩니다."
msgstr "The license server has been unreachable for %d hours. The catalog stops showing on the site when the grace period ends."

msgid "라이선스 설정"
msgstr "License settings"

msgid "라이선스 키"
msgstr "License key"

msgid "라이선스 키가 존재하지 않습니다."
msgstr "This license key does not exist."

msgid "라이선스 키를 찾을 수 없습니다. 키를 다시 확인해주세요."
msgstr "The license key was not found. Please check the key."

msgid "라이선스 활성화에 실패했습니다."
msgstr "License activation failed."

msgid "라이선스가 만료되어 카탈로그 출력이 중단되었습니다."
msgstr "The license has expired, so the catalog is no longer shown on the site."

msgid "라이선스가 만료되었습니다. %d일 후 카탈로그 출력이 중단됩니다."
msgstr "The license has expired. The catalog stops showing on the site in %d days."

msgid "라이선스가 만료되었습니다. 갱신하지 않으면 곧 동작이 중단됩니다."
msgstr "The license has expired. Renew it, or the plugin will stop working soon."

msgid "라이선스가 무효화되었습니다. 고객지원에 문의해주세요."
msgstr "The license has been invalidated. Please contact support."

msgid "라이선스가 활성화되었습니다."
msgstr "License activated."

msgid "라이선스를 비활성화했습니다."
msgstr "License deactivated."

msgid "라이선스의 도메인 한도를 초과했습니다."
msgstr "The license's domain limit has been reached."

msgid "라이선스의 도메인 한도를 초과했습니다. 사용하지 않는 도메인을 해제하거나 상위 플랜이 필요합니다."
msgstr "The license's domain limit has been reached. Release a domain you no longer use, or upgrade your plan."

msgid "마지막 오류"
msgstr "Last error"

msgid "만료"
msgstr "Expires"

msgid "무결성 정보가 불완전합니다. 정상 버전으로 재설치해주세요."
msgstr "The integrity information is incomplete. Please reinstall a genuine version."

msgid "무효화"
msgstr "Invalidated"

msgid "미활성"
msgstr "Not activated"

msgid "발급 이력 없음"
msgstr "Never issued"

msgid "비활성화"
msgstr "Deactivate"

msgid "상태"
msgstr "Status"

msgid "상태 확인"
msgstr "Check status"

msgid "서버 연결 실패. 인터넷 연결을 확인해주세요."
msgstr "Could not reach the server. Please check the internet connection."

msgid "서버 오류. 잠시 후 다시 시도해주세요."
msgstr "Server error. Please try again shortly."

msgid "서버 응답 형식 오류. 잠시 후 다시 시도해주세요."
msgstr "Unexpected server response. Please try again shortly."

msgid "서비스 일시 점검 중입니다."
msgstr "The service is temporarily under maintenance."

msgid "알 수 없는 오류가 발생했습니다."
msgstr "An unknown error occurred."

msgid "요청이 너무 많습니다. 잠시 후 다시 시도해주세요."
msgstr "Too many requests. Please try again shortly."

msgid "유예 모드"
msgstr "Grace mode"

msgid "이 도메인에서 라이선스를 해제할까요?"
msgstr "Release the license from this domain?"

msgid "이 도메인은 라이선스에 등록되지 않았습니다."
msgstr "This domain is not registered on the license."

msgid "이 도메인이 라이선스에 등록되지 않았습니다. 라이선스를 다시 활성화해주세요."
msgstr "This domain is not registered on the license. Please activate the license again."

msgid "이 버전은 보안 사유로 지원 중단되었습니다. 즉시 업데이트해주세요."
msgstr "This version is no longer supported for security reasons. Please update now."

msgid "이 버전이 플랫폼에 등록되지 않았습니다. 공급자에게 문의하거나 최신 버전으로 업데이트해주세요."
msgstr "This version is not registered on the platform. Contact your provider or update to the latest version."

msgid "이 플러그인 버전은 보안 사유로 지원되지 않습니다. 즉시 업데이트해주세요."
msgstr "This plugin version is not supported for security reasons. Please update now."

msgid "이 플러그인 버전이 등록되지 않았습니다. 최신 버전으로 업데이트해주세요."
msgstr "This plugin version is not registered. Please update to the latest version."

msgid "인증 정보가 유효하지 않습니다. 라이선스를 재활성화해주세요."
msgstr "The credentials are not valid. Please activate the license again."

msgid "인증 토큰이 만료되어 갱신 중입니다."
msgstr "The access token expired and is being renewed."

msgid "저장하려는 설정이 너무 큽니다."
msgstr "The settings you are saving are too large."

msgid "정상"
msgstr "Active"

msgid "토큰 만료"
msgstr "Token expires"

msgid "토큰을 새로 발급받았습니다."
msgstr "A new token was issued."

msgid "파일 변조 감지"
msgstr "File tampering detected"

msgid "플러그인 버전"
msgstr "Plugin version"

msgid "플러그인 파일이 변조되었습니다. 정상 버전으로 재설치해주세요."
msgstr "Plugin files have been modified. Please reinstall a genuine version."

msgid "현재 라이선스 등급에서는 사용할 수 없는 기능입니다."
msgstr "This feature is not available on your current license plan."

msgid "활성화"
msgstr "Activate"
